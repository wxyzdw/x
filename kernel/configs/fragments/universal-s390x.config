# NamikazeOS universal kernel fragment: s390x (IBM Z; installed-system target)
# Live USB does not apply to s390x; the kernel is used for KVM guests and
# LPAR installs with the same sealed-storage model.
CONFIG_S390=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_OVERLAY_FS=y
CONFIG_DM_CRYPT=y
CONFIG_DM_INTEGRITY=y
CONFIG_DM_VERITY=y
CONFIG_MODULES=y
CONFIG_S390_GUEST=y
CONFIG_VMCP=y
CONFIG_RTC_CLASS=y
