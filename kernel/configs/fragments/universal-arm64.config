# NamikazeOS universal kernel fragment: arm64 (single multi_v8 kernel)
CONFIG_ARM64=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_ZSTD=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_OVERLAY_FS=y
CONFIG_DM_CRYPT=y
CONFIG_DM_INTEGRITY=y
CONFIG_DM_VERITY=y
CONFIG_MODULES=y
# SoC families on the OneISO
CONFIG_ARCH_ROCKCHIP=y
CONFIG_ARCH_SUNXI=y
CONFIG_ARCH_MESON=y
CONFIG_ARCH_BCM2835=y
CONFIG_ARCH_TEGRA=y
CONFIG_ARCH_QCOM=y
CONFIG_ARCH_K3=y
CONFIG_ARCH_STARFIVE=y
CONFIG_ARCH_SOPHGO=y
CONFIG_ARCH_APPLE=y
CONFIG_ARCH_MXC=y
CONFIG_ARCH_LAYERSCAPE=y
CONFIG_ARCH_HISI=y
CONFIG_ARCH_SPRD=y
CONFIG_ARCH_ACTIONS=y
CONFIG_ARCH_AGILEX=y
CONFIG_ARCH_BITMAIN=y
CONFIG_ARCH_N5X=y
CONFIG_ARCH_S32=y
CONFIG_ARCH_UNIPHIER=y
CONFIG_ARCH_SYNQUACER=y
# Ethernet (stmmac family and friends)
CONFIG_STMMAC_ETH=m
CONFIG_STMMAC_PLATFORM=m
CONFIG_DWMAC_GENERIC=m
CONFIG_DWMAC_ROCKCHIP=m
CONFIG_DWMAC_SUN8I=m
CONFIG_DWMAC_MESON8B=m
CONFIG_DWMAC_STARFIVE=m
CONFIG_DWMAC_THEAD=m
CONFIG_BCMGENET=m
CONFIG_AM65_CPSW_NUSS=m
CONFIG_MVNETA=m
# Wireless
CONFIG_BRCMFMAC=m
CONFIG_IWLWIFI=m
CONFIG_MT7921E=m
CONFIG_RTW89_PCI=m
CONFIG_ATH11K=m
CONFIG_ATH11K_PCI=m
CONFIG_WL18XX=m
CONFIG_WLCORE=m
CONFIG_WLCORE_SDIO=m
CONFIG_RTL8723BS=m
CONFIG_RTL8XXXU=m
# GPU
CONFIG_DRM_PANFROST=m
CONFIG_DRM_PANTHOR=m
CONFIG_DRM_LIMA=m
CONFIG_DRM_VC4=m
CONFIG_DRM_V3D=m
CONFIG_DRM_MSM=m
CONFIG_DRM_POWERVR=m
CONFIG_DRM_TEGRA=m
CONFIG_DRM_SIMPLEDRM=y
# Bluetooth over UART for SBC combos
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIUART=m
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_BCM=y
CONFIG_BT_HCIUART_RTL=y
# Board infrastructure
CONFIG_MFD_RK8XX=y
CONFIG_MFD_RK8XX_I2C=y
CONFIG_REGULATOR_RK808=y
CONFIG_ROCKCHIP_PHY=y
CONFIG_PHY_ROCKCHIP_USBDP=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_MMC_SDHCI_OF_ARASAN=y
CONFIG_SPI_ROCKCHIP_SFC=y
CONFIG_RTC_CLASS=y
# Camera sensors common on SBCs
CONFIG_VIDEO_IMX219=m
CONFIG_VIDEO_IMX708=m
CONFIG_VIDEO_OV5647=m
